RESOURCES = [
    {
        "uri": "revolution://chats",
        "name": "Revolution 2 Conversations List",
        "description": "All conversations in Revolution 2 with participant turn details",
        "mimeType": "application/json"
    },
    {
        "uri": "revolution://active-chat",
        "name": "Active Revolution 2 Conversation",
        "description": "The transcript of the currently active conversation in Revolution 2",
        "mimeType": "application/json"
    },
    {
        "uri": "revolution://guide",
        "name": "Revolution 2 Built-in Guide",
        "description": "Official documentation and shortcut manual for Revolution 2",
        "mimeType": "text/plain"
    }
]

def handle_tool_call(name: str, args: dict) -> dict:
    if name == "revolution_list_chats":
        ipc_res = send_ipc("list_chats")
        if ipc_res and ipc_res.get("status") == "ok":
            return {"chats": ipc_res.get("chats", []), "activeChatId": ipc_res.get("activeChatId")}
        store = read_store()
        summaries = []
        for c in store.get("chats", []):
            summaries.append({
                "id": c["id"],
                "title": c["title"],
                "person1": c["person1"],
                "person2": c["person2"],
                "nextSpeaker": c["nextSpeaker"],
                "messageCount": len(c.get("messages", [])),
                "lastMessage": c["messages"][-1]["text"] if c.get("messages") else "",
                "updatedAt": c.get("updatedAt")
            })
        return {"chats": summaries, "activeChatId": store.get("activeChatId")}

    elif name == "revolution_create_chat":
        p1 = args.get("person1", "").strip()
        p2 = args.get("person2", "").strip()
        title = args.get("title", "").strip() or f"Chat with {p1} & {p2}"
        first = args.get("first_speaker", "").strip() or p1
        
        ipc_res = send_ipc("create_chat", title=title, person1=p1, person2=p2, firstSpeaker=first)
        if ipc_res and ipc_res.get("status") == "ok":
            return {
                "success": True,
                "chatId": ipc_res.get("chatId"),
                "title": title,
                "person1": p1,
                "person2": p2,
                "nextSpeaker": ipc_res.get("nextSpeaker"),
                "message": f"Created conversation '{title}' between {p1} and {p2}. {first} is first to speak."
            }
        
        store = read_store()
        c_id = str(uuid.uuid4()).upper()
        now = now_iso()
        new_chat = {
            "id": c_id,
            "title": title,
            "person1": p1,
            "person2": p2,
            "nextSpeaker": first,
            "createdAt": now,
            "updatedAt": now,
            "messages": []
        }
        store["chats"].insert(0, new_chat)
        store["activeChatId"] = c_id
        write_store(store)
        return {
            "success": True,
            "chatId": c_id,
            "title": title,
            "person1": p1,
            "person2": p2,
            "nextSpeaker": first,
            "message": f"Created conversation '{title}' between {p1} and {p2}. {first} is first to speak."
        }

    elif name == "revolution_send_message":
        text = args.get("message", "").strip()
        if not text:
            raise ValueError("Message cannot be empty")
        chat_query = args.get("chat_id")
        sender_override = args.get("sender")
        should_wait = bool(args.get("wait_for_reply", False))

        ipc_res = send_ipc("send_message", text=text, chatId=chat_query, sender=sender_override)
        if ipc_res and ipc_res.get("status") == "ok":
            actual_sender = ipc_res.get("sender")
            next_spk = ipc_res.get("nextSpeaker")
            chat_id = ipc_res.get("chatId")
            store = read_store()
            chat = resolve_chat(store.get("chats", []), store.get("activeChatId"), chat_id or chat_query)
            msg_count = len(chat.get("messages", [])) if chat else None
        else:
            store = read_store()
            chat = resolve_chat(store.get("chats", []), store.get("activeChatId"), chat_query)
            if not chat:
                raise ValueError("Conversation not found")

            actual_sender = sender_override.strip() if (sender_override and sender_override.strip()) else chat["nextSpeaker"]
            msg_id = str(uuid.uuid4()).upper()
            now = now_iso()
            msg = {
                "id": msg_id,
                "chatId": chat["id"],
                "sender": actual_sender,
                "text": text,
                "timestamp": now
            }
            chat.setdefault("messages", []).append(msg)
            chat["updatedAt"] = now

            p1 = chat["person1"]
            p2 = chat["person2"]
            if actual_sender.lower() == p1.lower():
                chat["nextSpeaker"] = p2
            elif actual_sender.lower() == p2.lower():
                chat["nextSpeaker"] = p1
            else:
                chat["nextSpeaker"] = p2 if chat["nextSpeaker"].lower() == p1.lower() else p1

            next_spk = chat["nextSpeaker"]
            chat_id = chat["id"]
            msg_count = len(chat["messages"])
            write_store(store)

        result = {
            "success": True,
            "sender": actual_sender,
            "text": text,
            "nextSpeaker": next_spk,
            "chatId": chat_id,
            "message": f"Sent as {actual_sender}. Turn passed to {next_spk}."
        }
        if should_wait:
            wait_res = wait_for_reply(chat_query=chat_id or chat_query, after_count=msg_count, expected_turn=actual_sender)
            if wait_res and wait_res.get("reply"):
                result["reply"] = wait_res["reply"]
                result["nextSpeaker"] = wait_res.get("nextSpeaker")
        return result

    elif name == "revolution_wait_for_reply":
        chat_query = args.get("chat_id")
        expected_turn = args.get("expected_turn")
        timeout = float(args.get("timeout", 300.0))
        wait_res = wait_for_reply(chat_query=chat_query, expected_turn=expected_turn, timeout=timeout)
        if not wait_res or not wait_res.get("reply"):
            raise ValueError("Timed out waiting for reply")
        return {
            "success": True,
            "reply": wait_res["reply"],
            "nextSpeaker": wait_res.get("nextSpeaker")
        }

    elif name == "revolution_get_chat":
        chat_query = args.get("chat_id")
        tail = args.get("tail")

        ipc_res = send_ipc("get_chat", chatId=chat_query)
        if ipc_res and ipc_res.get("status") == "ok":
            chat = ipc_res.get("chat")
        else:
            store = read_store()
            chat = resolve_chat(store.get("chats", []), store.get("activeChatId"), chat_query)

        if not chat:
            raise ValueError("Conversation not found")

        msgs = chat.get("messages", [])
        if tail and tail > 0:
            msgs = msgs[-tail:]

        return {
            "id": chat["id"],
            "title": chat["title"],
            "person1": chat["person1"],
            "person2": chat["person2"],
            "person1Image": chat.get("person1Image"),
            "person2Image": chat.get("person2Image"),
            "nextSpeaker": chat["nextSpeaker"],
            "messageCount": len(chat.get("messages", [])),
            "messages": msgs
        }

    elif name == "revolution_switch_speaker":
        chat_query = args.get("chat_id")
        ipc_res = send_ipc("switch_speaker", chatId=chat_query)
        if ipc_res and ipc_res.get("status") == "ok":
            return {
                "success": True,
                "nextSpeaker": ipc_res.get("nextSpeaker"),
                "message": f"Switched next speaker to {ipc_res.get('nextSpeaker')}."
            }

        store = read_store()
        chat = resolve_chat(store.get("chats", []), store.get("activeChatId"), chat_query)
        if not chat:
            raise ValueError("Conversation not found")

        p1 = chat["person1"]
        p2 = chat["person2"]
        chat["nextSpeaker"] = p2 if chat["nextSpeaker"].lower() == p1.lower() else p1
        chat["updatedAt"] = now_iso()
        write_store(store)
        return {
            "success": True,
            "nextSpeaker": chat["nextSpeaker"],
            "message": f"Switched next speaker to {chat['nextSpeaker']}."
        }

    elif name == "revolution_select_chat":
        chat_query = args.get("chat_id")
        ipc_res = send_ipc("select_chat", chatId=chat_query)
        store = read_store()
        chat = resolve_chat(store.get("chats", []), store.get("activeChatId"), chat_query)
        if not chat:
            raise ValueError("Conversation not found")
        store["activeChatId"] = chat["id"]
        write_store(store)
        return {
            "success": True,
            "activeChatId": chat["id"],
            "title": chat["title"],
            "message": f"Active conversation set to '{chat['title']}'."
        }

    elif name == "revolution_clear_chat":
        chat_query = args.get("chat_id")
        ipc_res = send_ipc("clear_chat", chatId=chat_query)
        store = read_store()
        chat = resolve_chat(store.get("chats", []), store.get("activeChatId"), chat_query)
        if not chat:
            raise ValueError("Conversation not found")
        chat["messages"] = []
        chat["updatedAt"] = now_iso()
        write_store(store)
        return {
            "success": True,
            "chatId": chat["id"],
            "message": f"Cleared message history for '{chat['title']}'."
        }

    elif name == "revolution_delete_chat":
        chat_query = args.get("chat_id")
        ipc_res = send_ipc("delete_chat", chatId=chat_query)
        store = read_store()
        chat = resolve_chat(store.get("chats", []), store.get("activeChatId"), chat_query)
        if not chat:
            raise ValueError("Conversation not found")
        target_id = chat["id"]
        store["chats"] = [c for c in store.get("chats", []) if c["id"] != target_id]
        if store.get("activeChatId") == target_id:
            store["activeChatId"] = store["chats"][0]["id"] if store["chats"] else None
        write_store(store)
        return {
            "success": True,
            "deletedChatId": target_id,
            "message": f"Deleted conversation '{chat['title']}'."
        }

    elif name == "revolution_open_app":
        for candidate in [
            Path("/Applications/Revolution 2.app"),
            Path.home() / "Applications" / "Revolution 2.app",
            CURRENT_DIR.parent / "Revolution 2.app"
        ]:
            if candidate.exists():
                os.system(f"open '{candidate}'")
                return {"success": True, "message": f"Opened {candidate.name}"}
        os.system("open -a 'Revolution 2' 2>/dev/null || open 'Revolution 2.app'")
        return {"success": True, "message": "Dispatched launch command for Revolution 2"}

    elif name == "revolution_get_status":
        ipc_res = send_ipc("status")
        store = read_store()
        return {
            "appName": "Revolution 2",
            "version": "1.0.1",
            "storageDirectory": str(DATA_DIR),
            "socketPath": SOCKET_PATH,
            "isIpcConnected": bool(ipc_res and ipc_res.get("status") == "ok"),
            "totalChats": len(store.get("chats", [])),
            "activeChatId": store.get("activeChatId")
        }

    elif name == "revolution_get_guide":
        return {
            "title": "Revolution 2 Guide",
            "version": "1.0.1",
            "lore": "The Beatles already made Revolution 1, so this is Revolution 2.",
            "shortcuts": {
                "Tab": "Change active speaker user without losing text focus",
                "Enter": "Send message and hand turn to the other person",
                "Cmd+N": "New conversation",
                "Cmd+E": "Edit participants & change photos",
                "Cmd+,": "Preferences menu",
                "Cmd+?": "Guide to Revolution 2"
            }
        }

    else:
        raise ValueError(f"Unknown tool '{name}'")

def handle_resource_read(uri: str) -> dict:
    if uri == "revolution://chats":
        store = read_store()
        return {
            "contents": [
                {
                    "uri": uri,
                    "mimeType": "application/json",
                    "text": json.dumps(store.get("chats", []), indent=2)
                }
            ]
        }
    elif uri == "revolution://active-chat":
        store = read_store()
        chat = resolve_chat(store.get("chats", []), store.get("activeChatId"))
        return {
            "contents": [
                {
                    "uri": uri,
                    "mimeType": "application/json",
                    "text": json.dumps(chat or {}, indent=2)
                }
            ]
        }
    elif uri == "revolution://guide":
        guide_text = (
            "Revolution 2 - Guide\n"
            "Version 1.0.1\n\n"
            "The Beatles already made Revolution 1, so this is Revolution 2.\n\n"
            "Keyboard shortcuts:\n"
            "• Tab: Swap active speaker\n"
            "• Enter: Send message and switch turns\n"
            "• Cmd+N: New conversation\n"
            "• Cmd+E: Edit conversation\n"
            "• Cmd+,: Preferences\n"
        )
        return {
            "contents": [
                {
                    "uri": uri,
                    "mimeType": "text/plain",
                    "text": guide_text
                }
            ]
        }
    else:
        raise ValueError(f"Resource not found: {uri}")

def process_mcp_message(msg: dict) -> dict:
    msg_id = msg.get("id")
    method = msg.get("method")
    params = msg.get("params", {})

    if method == "notifications/initialized":
        return None

    if method == "ping":
        return {"jsonrpc": "2.0", "id": msg_id, "result": {}}

    if method == "initialize":
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "protocolVersion": PROTOCOL_VERSION,
                "serverInfo": {
                    "name": "revolution-mcp",
                    "version": "1.0.1"
                },
                "capabilities": {
                    "tools": {},
                    "resources": {}
                }
            }
        }

    if method == "tools/list":
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "tools": TOOLS
            }
        }

    if method == "tools/call":
        tool_name = params.get("name")
        arguments = params.get("arguments", {})
        try:
            result = handle_tool_call(tool_name, arguments)
            return {
                "jsonrpc": "2.0",
                "id": msg_id,
                "result": {
                    "content": [
                        {
                            "type": "text",
                            "text": json.dumps(result, indent=2)
                        }
                    ]
                }
            }
        except Exception as e:
            return {
                "jsonrpc": "2.0",
                "id": msg_id,
                "error": {
                    "code": -32603,
                    "message": str(e)
                }
            }

    if method == "resources/list":
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "result": {
                "resources": RESOURCES
            }
        }

    if method == "resources/read":
        uri = params.get("uri")
        try:
            result = handle_resource_read(uri)
            return {
                "jsonrpc": "2.0",
                "id": msg_id,
                "result": result
            }
        except Exception as e:
            return {
                "jsonrpc": "2.0",
                "id": msg_id,
                "error": {
                    "code": -32602,
                    "message": str(e)
                }
            }

    if msg_id is not None:
        return {
            "jsonrpc": "2.0",
            "id": msg_id,
            "error": {
                "code": -32601,
                "message": f"Method '{method}' not found"
            }
        }
    return None

def main():
    while True:
        try:
            line = sys.stdin.readline()
            if not line:
                break
            line = line.strip()
            if not line:
                continue
            req = json.loads(line)
            res = process_mcp_message(req)
            if res is not None:
                sys.stdout.write(json.dumps(res) + "\n")
                sys.stdout.flush()
        except (KeyboardInterrupt, SystemExit):
            break
        except Exception as e:
            err_res = {
                "jsonrpc": "2.0",
                "id": None,
                "error": {
                    "code": -32700,
                    "message": f"Parse error: {str(e)}"
                }
            }
            sys.stdout.write(json.dumps(err_res) + "\n")
            sys.stdout.flush()

if __name__ == "__main__":
    main()
