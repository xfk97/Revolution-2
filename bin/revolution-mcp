#!/usr/bin/env python3
"""
Revolution 2 MCP Server
Model Context Protocol server for Revolution 2 macOS Application
Allows AI agents (Claude Desktop, Antigravity, Cursor, etc.) to control Revolution 2 directly.
Homage: The Beatles already made Revolution 1, so this is Revolution 2.
"""

import sys
import os
import json
import uuid
from pathlib import Path

CURRENT_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(CURRENT_DIR))

from revolution_core import (
    now_iso,
    send_ipc,
    read_store,
    write_store,
    resolve_chat,
    wait_for_reply,
    DATA_DIR,
    CHATS_FILE,
    SOCKET_PATH
)

PROTOCOL_VERSION = "2024-11-05"

TOOLS = [
    {
